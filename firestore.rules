rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Each user can read/write only their own profile; anyone signed in can read
    // (needed to check names/roles), but only the owner can create/update it.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    // Quizzes: anyone signed in can read (students need to see them).
    // Only admins can create/update/delete.
    match /quizzes/{quizId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();

      match /questions/{questionId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }
    }

    // Results: a student can create their own result and read their own results.
    // Admins can read all results (for the leaderboard / oversight).
    match /results/{resultId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.studentId == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
